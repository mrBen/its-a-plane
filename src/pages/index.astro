---
import Base from '../layouts/Base.astro';
import { strings } from '../strings';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const unitId = 'engine-count';
const unit = strings.units[unitId];
// Decision 41: the first unit holds two lessons.
// TODO: read the lessons done from src/lib/progress.ts, once a task writes it.
const lessonsDone = 0;
const lessonsTotal = 2;
---

<Base>
  <a class="card unit-card is-block" href={`${base}/learn/${unitId}`}>
    <div class="card-content">
      <p class="title is-4">{unit.name}</p>
      <p class="block">{unit.summary}</p>
      <progress class="progress is-large is-primary" value={lessonsDone} max={lessonsTotal}>
        {lessonsDone}/{lessonsTotal}
      </progress>
      <p class="is-size-7 block">{strings.unitProgress(lessonsDone, lessonsTotal)}</p>
      <span class="button is-primary is-rounded">{strings.unitStart}</span>
    </div>
  </a>
</Base>
