---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Compare from '../../components/Compare.astro';
import Lesson from '../../components/Lesson.svelte';
import { strings } from '../../strings';
import { units, type UnitId } from '../../units';

export function getStaticPaths() {
  return Object.keys(units).map((unit) => ({ params: { unit } }));
}

const unitId = Astro.params.unit as UnitId;
const unit = strings.units[unitId];
const { photoIds, part } = units[unitId];
const [left, right] = await Promise.all(photoIds.map((id) => getEntry('photos', id)));
if (!left || !right) throw new Error(`Unit ${unitId}: unknown photo id`);

// The unit feature lists the models that the lesson draws from.
const feature = await getEntry('features', unitId);
if (!feature) throw new Error(`Unit ${unitId}: no feature with this id`);
const modelIds = new Set(feature.data.types.flatMap((t) => t.modelIds.map((m) => m.id)));
const models = (await getCollection('models', (m) => modelIds.has(m.id))).map((m) => ({
  id: m.id,
  designation: m.data.designation,
}));
const photos = (await getCollection('photos', (p) => modelIds.has(p.data.modelId.id))).map((p) => ({
  id: p.id,
  modelId: p.data.modelId.id,
  image: p.data.image,
  author: p.data.author,
  license: p.data.license,
  licenseUrl: p.data.licenseUrl,
  sourceUrl: p.data.sourceUrl,
  crops: p.data.crops,
}));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={unit.name}>
  <h2 class="title is-3">{unit.name}</h2>

  <!-- The hash picks the screen, so the back button and a reload keep it, and no
       script switches the screens. Decision 18: the player skips the teaching screen with the
       button, and the link brings it back. -->
  <section id="teaching">
    <Compare photos={[left, right]} part={part} />
    <p class="block is-size-5">{unit.teaching}</p>
    <a class="button is-primary is-rounded is-medium" href="#lesson">{strings.startLesson}</a>
  </section>

  <section id="lesson">
    <p class="block"><a href="#teaching">{strings.showTeaching}</a></p>
    <!-- client:only, because the island draws the exercises at random, and a
         server render would draw a different set. -->
    <Lesson client:only="svelte" models={models} photos={photos} part={part} base={base} />
  </section>
</Base>

<style>
  #lesson {
    display: none;
  }
  #lesson:target {
    display: block;
  }
  :global(main:has(#lesson:target)) #teaching {
    display: none;
  }
</style>
